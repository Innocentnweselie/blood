PORT=5001
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/MedTracker
JWT_SECRET=replace_with_strong_secret
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Use "none" when frontend and backend are on different domains and HTTPS is enabled
COOKIE_SAMESITE=lax
JWT_COOKIE_NAME=mt_token
CSRF_COOKIE_NAME=mt_csrf
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
HCAPTCHA_SECRET=
LOG_FILE=
ALERT_EMAIL_TO=
ALERT_THROTTLE_MINUTES=5

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@example.com

GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
